__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Heavy regenerable snapshots (recreated by `investigate` / `agent-run`)
evidence/fox_services_*.db
evidence/api_dump_*.json
# Raw packet captures (UNMASKED prompts — sensitive, never commit)
evidence/pcaps/

# Real-service reconstructions (live prompts may linger — regenerable via
# `cli.py build`, never commit). The synthetic stateless-inference scaffold
# stays tracked; screenshots under docs/ are exempt.
reconstructions/*
!reconstructions/stateless-inference/
# Swarm run artifacts (client IPs, full prompts — regenerable, never commit)
evidence/swarm/results/

# Local env / editor
.env
.venv/
.vscode/
*.swp

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
